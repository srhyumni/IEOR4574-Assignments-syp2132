    sent_train = len([r for r in train_records if "Classify sentiment" in r["input"]])
    extr_train = len([r for r in train_records if "Extract JSON" in r["input"]])
    print(f"  Sentiment: {sent_train} | Extraction: {extr_train}")
    
    train_ds = InstructionDataset(train_records, tokenizer)
    eval_ds = InstructionDataset(eval_records, tokenizer)
    
    # Baseline
    print("\n" + "=" * 70)
    print("BASELINE EVALUATION")
    print("=" * 70)
    baseline_scores = assess_model_performance(model, tokenizer, eval_records)
    
    print(f"\nSentiment Accuracy: {baseline_scores['sentiment_accuracy']:.2%}")
    print(f"JSON Validity: {baseline_scores['json_validity']:.2%}")
    print(f"JSON Field Match: {baseline_scores['json_field_accuracy']:.2%}")
    
    # Training
    print("\n" + "=" * 70)
    print("FINE-TUNING")
    print("=" * 70)
    
    train_config = Seq2SeqTrainingArguments(
        output_dir="./sft_checkpoints",
        learning_rate=5e-4,
        num_train_epochs=5,
        per_device_train_batch_size=8,
        per_device_eval_batch_size=8,
        gradient_accumulation_steps=2,
        weight_decay=0.01,
        logging_steps=20,
        evaluation_strategy="epoch",
        save_strategy="epoch",
        load_best_model_at_end=True,
        metric_for_best_model="eval_loss",
        greater_is_better=False,
        predict_with_generate=False,
        no_cuda=True,
        save_total_limit=2,
        report_to="none",
    )
    
    collator = DataCollatorForSeq2Seq(tokenizer=tokenizer, model=model)
    
    trainer = Seq2SeqTrainer(
        model=model,
        args=train_config,
        train_dataset=train_ds,
        eval_dataset=eval_ds,
        tokenizer=tokenizer,
        data_collator=collator,
    )
    
    start = time.time()
    trainer.train()
    duration = time.time() - start
    
    # Post-training
    print("\n" + "=" * 70)
    print("POST-TRAINING EVALUATION")
    print("=" * 70)
    final_scores = assess_model_performance(model, tokenizer, eval_records)
    
    print(f"\nSentiment Accuracy: {final_scores['sentiment_accuracy']:.2%}")
    print(f"JSON Validity: {final_scores['json_validity']:.2%}")
    print(f"JSON Field Match: {final_scores['json_field_accuracy']:.2%}")
    
    # Results
    print("\n" + "=" * 70)
    print("RESULTS SUMMARY")
    print("=" * 70)
    print(f"{'Task':<20} {'Metric':<20} {'Before':<12} {'After':<12} {'Change':<10}")
    print("-" * 72)
    
    sent_change = final_scores['sentiment_accuracy'] - baseline_scores['sentiment_accuracy']
    json_change = final_scores['json_validity'] - baseline_scores['json_validity']
    field_change = final_scores['json_field_accuracy'] - baseline_scores['json_field_accuracy']
    
    print(f"{'Sentiment':<20} {'Accuracy':<20} {baseline_scores['sentiment_accuracy']:<12.2%} {final_scores['sentiment_accuracy']:<12.2%} {sent_change:+.2%}")
    print(f"{'Extraction':<20} {'JSON Valid':<20} {baseline_scores['json_validity']:<12.2%} {final_scores['json_validity']:<12.2%} {json_change:+.2%}")
    print(f"{'Extraction':<20} {'Field Match':<20} {baseline_scores['json_field_accuracy']:<12.2%} {final_scores['json_field_accuracy']:<12.2%} {field_change:+.2%}")
    
    # Save
    print("\n" + "=" * 70)
    print("SAVING MODEL")
    print("=" * 70)
    model.save_pretrained("./sft_model")
    tokenizer.save_pretrained("./sft_model")
    print("Saved to ./sft_model/")
    
    total_params = sum(p.numel() for p in model.parameters())
    print(f"\nParameters: {total_params:,}")
    print(f"Training time: {duration:.1f}s ({duration/60:.1f}m)")


