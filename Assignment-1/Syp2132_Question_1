
# Question 1
import torch
import json
import numpy as np
import pandas as pd
import re
from transformers import AutoTokenizer, AutoModelForCausalLM
from tqdm import tqdm

# Setup
SEED = 42
torch.manual_seed(SEED)
np.random.seed(SEED)

model_name = "distilgpt2"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(model_name)

if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

# Prompts
BASE_PROMPT = """You are given a purchase request. Extract a JSON object with fields item and quantity.
Text: "Order three boxes of blue markers for the design team."
JSON:"""

SCHEMA_PROMPT = """Output must be valid JSON exactly: {"item": "<string>", "quantity": <integer>}. No comments.
You are given a purchase request. Extract a JSON object with fields item and quantity.
Text: "Order three boxes of blue markers for the design team."
JSON:"""

# Decoding configurations
DECODING_CONFIG = [
    {"name": "Greedy", "do_sample": False},
    {"name": "Temp 0.7", "do_sample": True, "temperature": 0.7},
    {"name": "Temp 1.0", "do_sample": True, "temperature": 1.0},
    {"name": "Top-k 40", "do_sample": True, "temperature": 0.7, "top_k": 40},
    {"name": "Top-k 200", "do_sample": True, "temperature": 0.7, "top_k": 200},
    {"name": "Top-p 0.8", "do_sample": True, "temperature": 0.7, "top_p": 0.8},
    {"name": "Top-p 0.95", "do_sample": True, "temperature": 0.7, "top_p": 0.95},
]

MAX_NEW_TOKENS = 60
NUM_SAMPLES = 10

# Metrics
def calc_distinct_n(texts, n):
    """Calculate ratio of unique n-grams to total n-grams."""
    if not texts:
        return 0.0
    
    all_ngrams = []
    for text in texts:
        tokens = tokenizer.encode(text)
        for i in range(len(tokens) - n + 1):
            ngram = tuple(tokens[i:i + n])
            all_ngrams.append(ngram)
    
    if len(all_ngrams) == 0:
        return 0.0
    
    return len(set(all_ngrams)) / len(all_ngrams)


def calc_repetition_rate(texts):
    """Calculate fraction of adjacent identical tokens."""
    if not texts:
        return 0.0
    
    total_pairs = 0
    repeated_pairs = 0
    
    for text in texts:
        tokens = tokenizer.encode(text)
        for i in range(1, len(tokens)):
            total_pairs += 1
            if tokens[i] == tokens[i - 1]:
                repeated_pairs += 1
    
    if total_pairs == 0:
        return 0.0
    
    return repeated_pairs / total_pairs


def calc_json_validity(texts, debug=False):
    """Check if output is valid JSON with required fields."""
    if not texts:
        return 0.0
    
    valid_count = 0
    
    for idx, text in enumerate(texts):
        is_valid = False
        
        # Try parsing entire text
        try:
            data = json.loads(text.strip())
            if isinstance(data, dict) and "item" in data and "quantity" in data:
                valid_count += 1
                is_valid = True
                if debug and idx < 3:
                    print(f"  ✓ Sample {idx+1}: Valid")
                    print(f"    {text[:100]}")
                continue
        except (json.JSONDecodeError, ValueError):
            pass
        
        # Extract JSON pattern
        json_pattern = re.compile(r'\{[^{}]*\}')
        match = json_pattern.search(text)
        
        if match:
            json_str = match.group(0)
            try:
                data = json.loads(json_str)
                if isinstance(data, dict) and "item" in data and "quantity" in data:
                    valid_count += 1
                    is_valid = True
                    if debug and idx < 3:
                        print(f"  ✓ Sample {idx+1}: Valid")
                        print(f"    {json_str}")
            except (json.JSONDecodeError, ValueError):
                pass
        
        if debug and idx < 3 and not is_valid:
            print(f"  ✗ Sample {idx+1}: Invalid")
            print(f"    {text[:100]}")
    
    return valid_count / len(texts)


# Generation
def generate_one_sample(prompt, config):
    """Generate single sample with given config."""
    input_ids = tokenizer.encode(prompt, return_tensors="pt")
    prompt_length = input_ids.shape[1]
    
    gen_args = {
        "max_new_tokens": MAX_NEW_TOKENS,
        "do_sample": config.get("do_sample", False),
        "pad_token_id": tokenizer.eos_token_id,
    }
    
    if gen_args["do_sample"]:
        if "temperature" in config:
            gen_args["temperature"] = config["temperature"]
        if "top_k" in config:
            gen_args["top_k"] = config["top_k"]
        if "top_p" in config:
            gen_args["top_p"] = config["top_p"]
    
    with torch.no_grad():
        output = model.generate(input_ids, **gen_args)
    
    new_tokens = output[0][prompt_length:]
    text = tokenizer.decode(new_tokens, skip_special_tokens=True).strip()
    
    return text, len(new_tokens)


def generate_samples(prompt, config, num_samples, debug=False):
    """Generate multiple samples."""
    torch.manual_seed(SEED)
    np.random.seed(SEED)
    
    texts = []
    lengths = []
    
    for i in range(num_samples):
        text, length = generate_one_sample(prompt, config)
        texts.append(text)
        lengths.append(length)
        
        if debug and i < 3:
            print(f"\n  Sample {i+1} ({length} tokens):")
            print(f"  '{text[:150]}{'...' if len(text) > 150 else ''}'")
    
    return texts, lengths


def run_experiment(prompt, config, debug=False):
    """Run generation and compute metrics."""
    if debug:
        print(f"\n{'='*70}")
        print(f"Config: {config['name']}")
        print(f"{'='*70}")
    
    texts, lengths = generate_samples(prompt, config, NUM_SAMPLES, debug=debug)
    
    if debug:
        print(f"\nValidation:")
    
    json_validity = calc_json_validity(texts, debug=debug)
    
    return {
        "Config": config["name"],
        "Distinct-1": calc_distinct_n(texts, 1),
        "Distinct-2": calc_distinct_n(texts, 2),
        "Mean Length": np.mean(lengths),
        "Repetition Rate": calc_repetition_rate(texts),
        "JSON Validity": json_validity,
    }


# Main execution
if __name__ == "__main__":
    print("=" * 70)
    print("Problem 1: Decoding Controls and Structured Output")
    print("=" * 70)
    print(f"Model: {model_name}")
    print(f"Samples per config: {NUM_SAMPLES}")
    print(f"Max new tokens: {MAX_NEW_TOKENS}")
    print(f"Random seed: {SEED}")
    print()
    
    # Debug greedy with base prompt
    print("\n" + "=" * 70)
    print("Base Prompt - Greedy Decoding")
    print("=" * 70)
    greedy_config = {"name": "Greedy", "do_sample": False}
    base_greedy_result = run_experiment(BASE_PROMPT, greedy_config, debug=True)
    
    # Debug greedy with schema prompt
    print("\n" + "=" * 70)
    print("Schema Prompt - Greedy Decoding")
    print("=" * 70)
    schema_greedy_result = run_experiment(SCHEMA_PROMPT, greedy_config, debug=True)
    
    # Full experiments
    print("\n" + "=" * 70)
    print("Running full experiments...")
    print("=" * 70)
    
    print("\nBase Prompt experiments...")
    base_results = []
    for config in tqdm(DECODING_CONFIG, desc="Base Prompt"):
        result = run_experiment(BASE_PROMPT, config, debug=False)
        result["Prompt"] = "Base"
        base_results.append(result)
    
    print("\nSchema Prompt experiments...")
    schema_results = []
    for config in tqdm(DECODING_CONFIG, desc="Schema Prompt"):
        result = run_experiment(SCHEMA_PROMPT, config, debug=False)
        result["Prompt"] = "Schema"
        schema_results.append(result)
    
    # Format results
    def format_results(results):
        df = pd.DataFrame(results)
        df["Distinct-1"] = (df["Distinct-1"] * 100).round(1).astype(str) + "%"
        df["Distinct-2"] = (df["Distinct-2"] * 100).round(1).astype(str) + "%"
        df["Repetition Rate"] = (df["Repetition Rate"] * 100).round(1).astype(str) + "%"
        df["JSON Validity"] = (df["JSON Validity"] * 100).round(0).astype(int).astype(str) + "%"
        df["Mean Length"] = df["Mean Length"].round(1)
        return df[["Config", "Distinct-1", "Distinct-2", "Mean Length", 
                   "Repetition Rate", "JSON Validity"]]
    
    print("\n" + "=" * 70)
    print("RESULTS: Base Prompt")
    print("=" * 70)
    print(format_results(base_results).to_string(index=False))
    
    print("\n" + "=" * 70)
    print("RESULTS: Schema Prompt")
    print("=" * 70)
    print(format_results(schema_results).to_string(index=False))
    
    # Comparison
    print("\n" + "=" * 70)
    print("COMPARISON: JSON Validity (Base vs Schema)")
    print("=" * 70)
    
    comparison = []
    for base, schema in zip(base_results, schema_results):
        comparison.append({
            "Config": base["Config"],
            "Base Validity": f"{base['JSON Validity']*100:.0f}%",
            "Schema Validity": f"{schema['JSON Validity']*100:.0f}%",
            "Improvement": f"+{(schema['JSON Validity'] - base['JSON Validity'])*100:.0f}%"
        })
    
    print(pd.DataFrame(comparison).to_string(index=False))
    


"""
Analysis:

Higher temperature (1.0) and top-p (0.95) increased diversity as shown by
the Distinct-1 and Distinct-2 metrics. These settings allow sampling from
a wider probability distribution, producing more varied outputs. However,
this came at the cost of structural consistency - outputs drifted away from
valid JSON format more frequently.

The schema prompt significantly improved JSON validity across all configurations.
By explicitly specifying the expected output format upfront, the model had
stronger constraints to follow during generation. This shows that prompt
engineering can compensate for structural drift introduced by exploratory
decoding strategies.

For further improvement, I would implement constrained decoding using libraries
like 'guidance' or 'outlines' to enforce JSON grammar during token generation.
This would guarantee syntactically valid output regardless of temperature settings,
combining the benefits of creative sampling with structural reliability.
"""



