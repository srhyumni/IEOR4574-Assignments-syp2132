# Question 1
import torch
import json
import numpy as np
import pandas as pd
import re
from transformers import AutoTokenizer, AutoModelForCausalLM
from tqdm import tqdm

# Setup
SEED = 42
torch.manual_seed(SEED)
np.random.seed(SEED)

model_name = "distilgpt2"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(model_name)

if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token

# Prompts
BASE_PROMPT = """You are given a purchase request. Extract a JSON object with fields item and quantity.
Text: "Order three boxes of blue markers for the design team."
JSON:"""

SCHEMA_PROMPT = """Output must be valid JSON exactly: {"item": "<string>", "quantity": <integer>}. No comments.
You are given a purchase request. Extract a JSON object with fields item and quantity.
Text: "Order three boxes of blue markers for the design team."
JSON:"""

CONFIGS = [
    {"name": "Greedy", "do_sample": False},
    {"name": "Temp 0.7", "do_sample": True, "temperature": 0.7},
    {"name": "Temp 1.0", "do_sample": True, "temperature": 1.0},
    {"name": "Top-k 40", "do_sample": True, "temperature": 0.7, "top_k": 40},
    {"name": "Top-k 200", "do_sample": True, "temperature": 0.7, "top_k": 200},
    {"name": "Top-p 0.8", "do_sample": True, "temperature": 0.7, "top_p": 0.8},
    {"name": "Top-p 0.95", "do_sample": True, "temperature": 0.7, "top_p": 0.95},
]

MAX_NEW_TOKENS = 60
NUM_SAMPLES = 10


def get_unique_ngrams(texts, n):
    """Calculate distinct-n metric."""
    if not texts:
        return 0.0
    
    ngrams = []
    for text in texts:
        tokens = tokenizer.encode(text)
        ngrams.extend(tuple(tokens[i:i + n]) for i in range(len(tokens) - n + 1))
    
    return len(set(ngrams)) / len(ngrams) if ngrams else 0.0


def check_repetition(texts):
    """Calculate repetition rate."""
    if not texts:
        return 0.0
    
    total = repeats = 0
    for text in texts:
        tokens = tokenizer.encode(text)
        for i in range(1, len(tokens)):
            total += 1
            if tokens[i] == tokens[i - 1]:
                repeats += 1
    
    return repeats / total if total > 0 else 0.0


def check_json_format(texts):
    """Check JSON validity."""
    if not texts:
        return 0.0
    
    valid = 0
    for text in texts:
        # Try direct parse
        try:
            data = json.loads(text.strip())
            if isinstance(data, dict) and "item" in data and "quantity" in data:
                valid += 1
                continue
        except:
            pass
        
        # Try regex extraction
        match = re.search(r'\{[^{}]*\}', text)
        if match:
            try:
                data = json.loads(match.group(0))
                if isinstance(data, dict) and "item" in data and "quantity" in data:
                    valid += 1
            except:
                pass
    
    return valid / len(texts)


def generate_text(prompt, config):
    """Generate single sample."""
    inputs = tokenizer.encode(prompt, return_tensors="pt")
    input_len = inputs.shape[1]
    
    gen_params = {
        "max_new_tokens": MAX_NEW_TOKENS,
        "do_sample": config.get("do_sample", False),
        "pad_token_id": tokenizer.eos_token_id,
    }
    
    if gen_params["do_sample"]:
        for key in ["temperature", "top_k", "top_p"]:
            if key in config:
                gen_params[key] = config[key]
    
    with torch.no_grad():
        outputs = model.generate(inputs, **gen_params)
    
    new_tokens = outputs[0][input_len:]
    return tokenizer.decode(new_tokens, skip_special_tokens=True).strip(), len(new_tokens)


def run_generation(prompt, config, num_samples):
    """Generate multiple samples."""
    torch.manual_seed(SEED)
    np.random.seed(SEED)
    
    results = []
    lengths = []
    
    for _ in range(num_samples):
        text, length = generate_text(prompt, config)
        results.append(text)
        lengths.append(length)
    
    return results, lengths


def evaluate_config(prompt, config):
    """Evaluate a configuration."""
    outputs, lengths = run_generation(prompt, config, NUM_SAMPLES)
    
    return {
        "Config": config["name"],
        "Distinct-1": get_unique_ngrams(outputs, 1),
        "Distinct-2": get_unique_ngrams(outputs, 2),
        "Mean Length": np.mean(lengths),
        "Repetition Rate": check_repetition(outputs),
        "JSON Validity": check_json_format(outputs),
    }


# Main
if __name__ == "__main__":
    print("=" * 70)
    print("Problem 1: Decoding Controls and Structured Output")
    print("=" * 70)
    print(f"Model: {model_name}")
    print(f"Samples per config: {NUM_SAMPLES}")
    print(f"Max new tokens: {MAX_NEW_TOKENS}")
    print(f"Random seed: {SEED}\n")
    
    # Run experiments
    print("Running experiments...")
    base_results = []
    schema_results = []
    
    for config in tqdm(CONFIGS, desc="Progress"):
        base_res = evaluate_config(BASE_PROMPT, config)
        base_res["Prompt"] = "Base"
        base_results.append(base_res)
        
        schema_res = evaluate_config(SCHEMA_PROMPT, config)
        schema_res["Prompt"] = "Schema"
        schema_results.append(schema_res)
    
    # Format results
    def format_table(results):
        df = pd.DataFrame(results)
        df["Distinct-1"] = (df["Distinct-1"] * 100).round(1).astype(str) + "%"
        df["Distinct-2"] = (df["Distinct-2"] * 100).round(1).astype(str) + "%"
        df["Repetition Rate"] = (df["Repetition Rate"] * 100).round(1).astype(str) + "%"
        df["JSON Validity"] = (df["JSON Validity"] * 100).round(0).astype(int).astype(str) + "%"
        df["Mean Length"] = df["Mean Length"].round(1)
        return df[["Config", "Distinct-1", "Distinct-2", "Mean Length", 
                   "Repetition Rate", "JSON Validity"]]
    
    print("\n" + "=" * 70)
    print("RESULTS: Base Prompt")
    print("=" * 70)
    print(format_table(base_results).to_string(index=False))
    
    print("\n" + "=" * 70)
    print("RESULTS: Schema Prompt")
    print("=" * 70)
    print(format_table(schema_results).to_string(index=False))
    
    # Comparison
    print("\n" + "=" * 70)
    print("COMPARISON: JSON Validity (Base vs Schema)")
    print("=" * 70)
    
    comparison = []
    for base, schema in zip(base_results, schema_results):
        comparison.append({
            "Config": base["Config"],
            "Base Validity": f"{base['JSON Validity']*100:.0f}%",
            "Schema Validity": f"{schema['JSON Validity']*100:.0f}%",
            "Improvement": f"+{(schema['JSON Validity'] - base['JSON Validity'])*100:.0f}%"
        })
    
    print(pd.DataFrame(comparison).to_string(index=False))


"""
ANALYSIS:

Setting the temperature to 1.0 and the top-p value to 0.95 made the outputs 
more diverse, as seen in the Distinct-1 and Distinct-2 metrics. But, this also 
caused the outputs to be less consistent in structure and more likely to break 
valid JSON.

Adding a schema prompt helped keep the JSON valid in different settings. 
When the expected output format is clearly stated from the start, the model 
follows the desired structure more closely. This shows that prompt engineering 
helps reduce structural drift, especially when exploring different decoding options.

